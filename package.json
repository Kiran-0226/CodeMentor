{
  "name": "codementor",
  "displayName": "CodeMentor",
  "description": "Understand your code and explore better alternatives with Gemini.",
  "version": "0.0.1",
  "publisher": "kiran0226",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codementor.analyzeSelection",
    "onCommand:codementor.setGeminiApiKey",
    "onCommand:codementor.clearGeminiApiKey",
    "onCommand:codementor.toggleLiveAnalysis",
    "onCommand:codementor.setLearningLevel"
  ],
  "keybindings": [
    {
      "command": "codementor.analyzeSelection",
      "key": "ctrl+alt+m",
      "mac": "cmd+alt+m",
      "when": "editorTextFocus && editorHasSelection"
    }
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codementor.analyzeSelection",
        "title": "CodeMentor: Explain and Improve Selection"
      },
      {
        "command": "codementor.setGeminiApiKey",
        "title": "CodeMentor: Set Gemini API Key"
      },
      {
        "command": "codementor.clearGeminiApiKey",
        "title": "CodeMentor: Clear Gemini API Key"
      },
      {
        "command": "codementor.toggleLiveAnalysis",
        "title": "CodeMentor: Toggle Live Analysis"
      },
      {
        "command": "codementor.setLearningLevel",
        "title": "CodeMentor: Set Learning Level"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codementor.analyzeSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "CodeMentor",
      "properties": {
        "codementor.analysisMode": {
          "type": "string",
          "enum": ["both", "explain", "improve"],
          "default": "both",
          "description": "Choose whether CodeMentor explains code, suggests improvements, or does both."
        },
        "codementor.geminiModel": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "description": "Gemini model used for code analysis."
        },
        "codementor.fallbackGeminiModel": {
          "type": "string",
          "default": "gemini-3.6-flash",
          "description": "Model to try if the primary Gemini model returns a temporary server error. Set this to an empty string to disable fallback."
      },
      "codementor.liveAnalysis": {
        "type": "boolean",
        "default": false,
        "description": "Automatically re-analyze the selected code after you edit it. Only the selected code is sent to Gemini."
      },
      "codementor.learningLevel": {
        "type": "string",
        "enum": ["beginner", "intermediate", "advanced"],
        "default": "beginner",
        "description": "Adjust explanations and suggestions for your programming experience level."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiran-0226/CodeMentor.git"
  }
}
